{
	"name": "saaschat-app",
	"version": "0.0.1",
	"scripts": {
		"sveltekit:dev": "vite dev --host --port 40000",
		"dev": "bun run sveltekit:dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --plugin-search-dir . --check . && eslint .",
		"format": "prettier --plugin-search-dir . --write .",
		"build:widget": "vite -c vite.widget.config.js build"
	},
	"devDependencies": {
		"@iconify/svelte": "^4.1.0",
		"@sveltejs/adapter-auto": "^3.3.1",
		"@sveltejs/kit": "^2.11.1",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/typography": "^0.5.15",
		"@types/cookie": "^0.6.0",
		"@typescript-eslint/eslint-plugin": "^8.18.0",
		"@typescript-eslint/parser": "^8.18.0",
		"eslint": "^9.17.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.46.1",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.2",
		"svelte": "^5.13.0",
		"svelte-check": "^3.8.6",
		"tailwindcss-animate": "^1.0.7",
		"tslib": "^2.8.1",
		"typescript": "^5.7.2",
		"vite": "^5.4.11"
	},
	"type": "module",
	"dependencies": {
		"@sveltejs/vite-plugin-svelte": "^4.0.3",
		"@tanstack/svelte-query": "^5.62.7",
		"@tanstack/svelte-query-devtools": "^5.62.7",
		"@tiptap/core": "^2.10.3",
		"@tiptap/pm": "^2.10.3",
		"@tiptap/starter-kit": "^2.10.3",
		"autoprefixer": "^10.4.20",
		"date-fns": "^3.6.0",
		"ky": "^1.7.3",
		"postcss": "^8.4.49",
		"tailwind-merge": "^2.5.5",
		"tailwindcss": "^3.4.16"
	}
}
